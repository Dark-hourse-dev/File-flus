{
  "manifest_version": 3,
  "name": "FileFlux — Open Anything",
  "version": "1.0.0",
  "description": "Open, edit & convert ANY file right in your browser. No extra software needed. fr fr no cap.",
  "author": "FileFlux Team",
  "homepage_url": "https://fileflux.app",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FileFlux — Open Anything"
  },

  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"],
      "run_at": "document_end"
    }
  ],

  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "notifications",
    "tabs",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "pages/viewer.html",
        "css/*.css",
        "js/*.js",
        "icons/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Open FileFlux"
    }
  }
}
